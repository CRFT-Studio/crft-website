---
import AuditReport from "@/layouts/AuditReport.astro";

export const auditData = {
  firstName: "Jessica",
  lastName: "Clifton",
  companyName: "Caregility",
  url: "caregility.com",
  email: "",
  role: "",
  date: "November 25th 2026",
  beforeImgPath: "/src/images/audits/caregility-before.png",
  afterImgPath: "/src/images/audits/caregility-after.png",
  annotations: [
    {
      question: "Note 1 - Announcement banner",
      answer: "The blue whitepaper banner wraps to three lines on mobile and pushes the headline down. Move the whitepaper into a resource callout farther down the page so the first screen can explain what Caregility does."
    },
    {
      question: "Note 2 - H1 and subtitle",
      answer: "'Connecting Care Everywhere' works as a tagline, but it doesn't tell a hospital team what changes for them. Keep it above the headline and lead with 'Put expert help in every patient room.' Use the subtitle to explain how: one platform for virtual nursing, AI observation, tele-critical care, and command center workflows."
    },
    {
      question: "Note 3 - CTA buttons",
      answer: "'Scroll & click to explore' explains how to use the illustration, but it doesn't give visitors a direct next step. Put 'Schedule a Demo' beneath the subtitle as the primary action and 'See the platform' beside it as a secondary option. On mobile, both are visible before the care-setting tabs."
    },
    {
      question: "Note 4 - Care-setting tabs",
      answer: "The hospital illustration's unlabeled dots make visitors tap to find out what each one means. Replace them with tabs for Med/Surg, Virtual Observation, Emergency, ICU, and Command Center. Open on Med/Surg to show an example immediately. On mobile, let the tabs scroll sideways and the page scroll normally."
    },
    {
      question: "Note 5 - Hero image and layout",
      answer: "Replace the hospital drawing with a patient-room photo that shows the bedside team and the virtual nurse on the in-room TV. Add a sample event card showing the virtual nurse starting discharge education while the bedside nurse handles other care. On mobile, stack the photo beneath the tabs and keep that one card legible."
    },
    {
      question: "Note 6 - Proof points",
      answer: "Put the scale and reliability figures in a strip directly below the hero. Lead with the 19,000+ patient rooms and 99.99% availability shown in the mockup: one tells hospital teams how widely the platform is used, and the other speaks to whether they can depend on it."
    }
  ]
};
---
<AuditReport
firstName={auditData.firstName}
lastName={auditData.lastName}
companyName={auditData.companyName}
url={auditData.url}
email={auditData.email}
role={auditData.role}
date={auditData.date}
beforeImgPath={auditData.beforeImgPath}
afterImgPath={auditData.afterImgPath}
annotations={auditData.annotations}
/>
