---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  desktopAlt: string;
  mobileAlt: string;
  chrome?: string;
}

const { desktop, mobile, desktopAlt, mobileAlt, chrome = "caregility.com" } = Astro.props;
---

<div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_240px]">
  <figure>
    <figcaption class="mb-3 text-sm text-neutral-400">Desktop · 1440 × 900</figcaption>
    <div class="overflow-hidden rounded-xl border border-neutral-700 bg-neutral-950">
      <div class="flex items-center gap-2 border-b border-neutral-700 px-3 py-2">
        <span class="h-2 w-2 rounded-full bg-neutral-600"></span>
        <span class="h-2 w-2 rounded-full bg-neutral-600"></span>
        <span class="h-2 w-2 rounded-full bg-neutral-600"></span>
        <span class="ml-2 truncate text-xs text-neutral-500">{chrome}</span>
      </div>
      <Image
        src={desktop}
        alt={desktopAlt}
        class="block h-auto w-full"
        widths={[640, 960, 1280, 1800]}
        sizes="(min-width: 1024px) 760px, 100vw"
        quality={82}
      />
    </div>
  </figure>
  <figure class="mx-auto w-full max-w-[240px]">
    <figcaption class="mb-3 text-sm text-neutral-400">Mobile · 390 × 844</figcaption>
    <div class="overflow-hidden rounded-[1.6rem] border-[7px] border-neutral-950 bg-neutral-950">
      <Image
        src={mobile}
        alt={mobileAlt}
        class="block h-auto w-full"
        widths={[390, 780]}
        sizes="240px"
        quality={82}
      />
    </div>
  </figure>
</div>
