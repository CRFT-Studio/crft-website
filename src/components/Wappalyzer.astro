---
const { url } = Astro.props;
---

<div class="flex flex-col gap-8" id="wappalyzer-tech-data" data-lookup-url={url}>
    <div class="flex flex-row gap-4 justify-start text-neutral-300">Fetching tech stack...</div>
</div>

<script>
    import { fetchLookupSection } from '../lib/lookup/client';

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function renderTech(container, techByCategory) {
        const categories = Object.entries(techByCategory || {});
        if (!categories.length) {
            container.innerHTML = '<div class="text-neutral-300">No technology data available</div>';
            return;
        }

        container.innerHTML = categories.map(([category, techs]) => `
            <div data-category="${escapeHtml(category)}">
                <h3 class="text-xl font-medium mb-4">${escapeHtml(category)}</h3>
                <div class="grid lg:grid-cols-2 gap-4">
                    ${techs.map((tech) => `
                        <a href="${escapeHtml(tech.website || '#')}?utm_source=crftLookup" target="_blank" class="flex flex-col gap-2 square-card p-4 relative hover:bg-neutral-700 transition-all" data-tech-name="${escapeHtml(tech.name)}" data-tech-icon="${escapeHtml(tech.icon || '')}">
                            <div class="flex flex-row gap-2 items-center">
                                <img src="/icons/${escapeHtml(tech.icon || '')}" class="w-5 h-5" alt="" />
                                <div>${escapeHtml(tech.name)}</div>
                            </div>
                            <div class="text-pretty">${escapeHtml(tech.description || '')}</div>
                            <svg class="absolute top-0 right-0 mt-3 mr-3" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="m216-160-56-56 464-464H360v-80h400v400h-80v-264L216-160Z"/></svg>
                        </a>
                    `).join('')}
                </div>
            </div>
        `).join('');
    }

    const container = document.getElementById('wappalyzer-tech-data');
    const url = container?.getAttribute('data-lookup-url');

    if (container && url) {
        fetchLookupSection('wappalyzer', url)
            .then((data) => {
                renderTech(container, data.techByCategory);
                document.dispatchEvent(new Event('wappalyzer:loaded'));
            })
            .catch((error) => {
                console.error('[Wappalyzer] Error fetching tech stack:', error);
                container.innerHTML = '<div class="text-neutral-300">No technology data available</div>';
                document.dispatchEvent(new Event('wappalyzer:loaded'));
            });
    }
</script>
