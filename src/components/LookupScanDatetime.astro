<script>
    document.querySelectorAll<HTMLFormElement>("[data-lookup-scan]").forEach((form) => {
        if (form.dataset.lookupDatetimeBound === "true") return;
        form.dataset.lookupDatetimeBound = "true";
        form.addEventListener("submit", () => {
            const datetimeInput = form.querySelector<HTMLInputElement>('input[name="datetime"]');
            if (datetimeInput) {
                datetimeInput.value = new Date().toISOString().substring(0, 19).replaceAll(":", "-");
            }
        });
    });
</script>
