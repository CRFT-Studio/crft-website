---
const { url } = Astro.props;
---
<div data-lookup-url={url}>
    <div class="flex justify-start mb-4">
        <div id="lighthouse-tabs" class="inline-flex flex-row square-card p-[2px] border-[1px] gap-2 text-sm text-nowrap">
            <div id="desktop-tab" class="tab-active border-[1px] px-2 py-1 hover:cursor-pointer transition-all">Desktop</div>
            <div id="mobile-tab" class="px-2 py-1 border-[1px] hover:cursor-pointer transition-all">Mobile</div>
        </div>
    </div>

    <div id="lighthouse-viewer-desktop" class="lighthouse-viewer square-card p-0 bg-[#212121] overflow-x-auto max-sm:w-[calc(100vw-60px)]">
        <div class="flex flex-row gap-4 justify-start text-neutral-300 p-4">Fetching desktop report...</div>
    </div>

    <div id="lighthouse-viewer-mobile" class="lighthouse-viewer square-card p-0 bg-[#212121] overflow-x-auto max-sm:w-[calc(100vw-60px)]" hidden>
        <div class="flex flex-row gap-4 justify-start text-neutral-300 p-4">Fetching mobile report...</div>
    </div>
</div>

<style>
@reference "../styles/global.css";
    #lighthouse-tabs div {
        @apply border-transparent;
    }
    .tab-active {
        border-color: #525252 !important;
        @apply bg-neutral-700;
    }

    [hidden] {
        display: none;
    }
</style>

<script>
    import $ from 'jquery';
    import { renderReport } from 'lighthouse-viewer';
    import { fetchLookupSection } from '../lib/lookup/client';

    function showError(viewerId, message) {
        const viewer = document.querySelector(`#${viewerId}`);
        if (viewer) {
            viewer.innerHTML = `<div class="text-neutral-300 p-4">${message}</div>`;
        }
    }

    function injectReport(id, data) {
        let node = document.getElementById(id);
        if (!node) {
            node = document.createElement('span');
            node.id = id;
            node.hidden = true;
            document.body.appendChild(node);
        }
        node.textContent = JSON.stringify(data);
    }

    function renderLighthouseReport(data, viewerId, reportType) {
        try {
            const viewer = document.querySelector(`#${viewerId}`);
            if (!viewer) return;
            viewer.innerHTML = '';
            viewer.appendChild(renderReport(data, {}));

            setTimeout(() => {
                const $viewer = $(`#${viewerId}`);
                $viewer.find('.lh-sticky-header').css("position", "static");
                $viewer.find('.lh-topbar').css("position", "static");
                $viewer.find('.lh-filmstrip').css("overflow", "hidden");
            }, 100);
        } catch (error) {
            console.error(`Error rendering ${reportType} report:`, error);
            showError(viewerId, `Failed to render ${reportType} report. Please try again later.`);
        }
    }

    $(async () => {
        $("#lighthouse-tabs div").click(function() {
            if ($(this).hasClass("tab-active")) return;
            $("#lighthouse-tabs .tab-active").removeClass("tab-active");
            $(this).addClass("tab-active");
            const tabId = $(this).attr("id");
            if (tabId === "desktop-tab") {
                $("#lighthouse-viewer-desktop").removeAttr("hidden");
                $("#lighthouse-viewer-mobile").attr("hidden", "hidden");
            } else {
                $("#lighthouse-viewer-mobile").removeAttr("hidden");
                $("#lighthouse-viewer-desktop").attr("hidden", "hidden");
            }
        });

        const url = document.querySelector('[data-lookup-url]')?.getAttribute('data-lookup-url');
        if (!url) {
            showError('lighthouse-viewer-desktop', 'Error fetching desktop report');
            showError('lighthouse-viewer-mobile', 'Error fetching mobile report');
            return;
        }

        try {
            const reports = await fetchLookupSection('lighthouse', url);

            if (reports.desktop) {
                injectReport('desktop-report', reports.desktop);
                renderLighthouseReport(reports.desktop, 'lighthouse-viewer-desktop', 'Desktop');
            } else {
                showError('lighthouse-viewer-desktop', reports.errors?.desktop || 'Error fetching desktop report');
            }

            if (reports.mobile) {
                injectReport('mobile-report', reports.mobile);
                renderLighthouseReport(reports.mobile, 'lighthouse-viewer-mobile', 'Mobile');
            } else {
                showError('lighthouse-viewer-mobile', reports.errors?.mobile || 'Error fetching mobile report');
            }
        } catch (error) {
            console.error('Error fetching Lighthouse reports:', error);
            showError('lighthouse-viewer-desktop', 'Error fetching desktop report');
            showError('lighthouse-viewer-mobile', 'Error fetching mobile report');
        }

        $(document).trigger('lighthouse:rendered');
    });
</script>
