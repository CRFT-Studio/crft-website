---
const { compact = false } = Astro.props;
const datetime = new Date().toISOString().substring(0, 16).replaceAll(":", "-");
---
<form action="/lookup" method="GET" class:list={["flex items-center", compact ? "lg:flex-row flex-col lg:gap-1 gap-2" : "lg:flex-row flex-col lg:gap-1 gap-2"]} data-lookup-scan>
    <div class="w-full relative lg:mr-[2px]">
        <svg class="absolute top-1/2 -translate-y-1/2 ml-2" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#a3a3a3"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>
        <input data-lookup-url type="url" placeholder="https://yoursite.com" name="url" class="text-lg h-10 text-neutral-300 bg-neutral-800 border-neutral-600 outline-neutral-600 pl-10 w-full">
        <input type="hidden" name="datetime" value={datetime}>
    </div>
    <button class="lg:w-auto text-lg h-10 w-full px-2 py-1 border border-neutral-600 bg-neutral-800 hover:bg-neutral-700 transition-all text-nowrap cursor-pointer">Scan a website</button>
</form>

<script>
    document.querySelectorAll<HTMLFormElement>("[data-lookup-scan]").forEach((form) => {
        const input = form.querySelector<HTMLInputElement>("[data-lookup-url]");
        if (!input) return;
        input.addEventListener("focus", () => {
            if (!input.value) input.value = "https://";
        });
        input.addEventListener("blur", () => {
            if (input.value === "https://") input.value = "";
        });
        input.addEventListener("input", () => {
            if (input.value.toLowerCase().startsWith("https://https://")) {
                input.value = input.value.replace(/^https:\/\/https:\/\//i, "https://");
            }
        });
    });
</script>
